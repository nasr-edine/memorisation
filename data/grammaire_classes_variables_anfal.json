{
  "pour": "anfal",
  "matiere": "francais",
  "titre": "Grammaire : les classes grammaticales variables",
  "items": [
    {
      "id": "classe-variable",
      "type": "definition",
      "titre": "Une classe variable",
      "texte": "Un mot variable peut changer de forme.",
      "exemple": "petit, petite, petits, petites.",
      "mots_cles": [
        ["variable"],
        ["changer de forme"]
      ]
    },
    {
      "id": "cinq-classes-variables",
      "type": "definition",
      "titre": "Les 5 classes variables",
      "texte": "Les 5 classes variables sont le nom, le déterminant, l'adjectif, le verbe et le pronom.",
      "mots_cles": [
        ["nom"],
        ["déterminant"],
        ["adjectif"],
        ["verbe"],
        ["pronom"]
      ]
    },
    {
      "id": "verbe-role",
      "type": "definition",
      "titre": "Le verbe",
      "texte": "Le verbe exprime une action ou un état.",
      "exemple": "Lina court. Lina semble fatiguée.",
      "mots_cles": [
        ["verbe"],
        ["action"],
        ["état"]
      ]
    },
    {
      "id": "reconnaitre-verbe",
      "type": "regle",
      "titre": "Reconnaître un verbe",
      "texte": "On peut souvent encadrer le verbe avec ne... pas.",
      "exemple": "Lina court. → Lina ne court pas.",
      "mots_cles": [
        ["ne... pas"],
        ["verbe"]
      ]
    },
    {
      "id": "variation-verbe",
      "type": "regle",
      "titre": "Les variations du verbe",
      "texte": "Le verbe varie selon le temps, le mode, la personne et le nombre.",
      "exemple": "Je joue. Nous jouons.",
      "mots_cles": [
        ["temps"],
        ["mode"],
        ["personne"],
        ["nombre"]
      ]
    },
    {
      "id": "accord-verbe",
      "type": "regle",
      "titre": "L'accord du verbe",
      "texte": "Le verbe s'accorde avec son sujet.",
      "exemple": "Elle joue. Elles jouent.",
      "mots_cles": [
        ["verbe"],
        ["sujet"],
        ["s'accorde"]
      ]
    },
    {
      "id": "radical-terminaison",
      "type": "definition",
      "titre": "Radical et terminaison",
      "texte": "Le radical porte le sens du verbe. La terminaison change.",
      "exemple": "jou-ons : jou est le radical, ons la terminaison.",
      "mots_cles": [
        ["radical"],
        ["sens du verbe"],
        ["terminaison"]
      ]
    },
    {
      "id": "groupes-verbes",
      "type": "definition",
      "titre": "Les 3 groupes de verbes",
      "texte": "1er groupe : -er. 2e groupe : -ir avec nous -issons. 3e groupe : les autres verbes.",
      "exemple": "chanter : 1er ; finir : 2e ; prendre : 3e.",
      "mots_cles": [
        ["1er groupe", "-er"],
        ["2e groupe", "-ir", "-issons"],
        ["3e groupe", "autres verbes"]
      ]
    },
    {
      "id": "nom-commun",
      "type": "definition",
      "titre": "Le nom commun",
      "texte": "Le nom commun désigne une personne, un animal, un objet ou une idée.",
      "exemple": "fille, chat, table, joie.",
      "mots_cles": [
        ["nom commun"],
        ["désigne"]
      ]
    },
    {
      "id": "groupe-nominal",
      "type": "definition",
      "titre": "Le groupe nominal minimal",
      "texte": "Un groupe nominal minimal contient un déterminant et un nom.",
      "exemple": "Le chat.",
      "mots_cles": [
        ["groupe nominal", "GN"],
        ["déterminant"],
        ["nom"]
      ]
    },
    {
      "id": "nom-noyau",
      "type": "definition",
      "titre": "Le nom noyau",
      "texte": "Le nom noyau est le mot principal du groupe nominal.",
      "exemple": "Le petit chat : chat est le nom noyau.",
      "mots_cles": [
        ["nom noyau"],
        ["mot principal"]
      ]
    },
    {
      "id": "accord-gn",
      "type": "regle",
      "titre": "Les accords dans le groupe nominal",
      "texte": "Le déterminant et l'adjectif s'accordent avec le nom en genre et en nombre.",
      "exemple": "Une petite fille. Des petits garçons.",
      "mots_cles": [
        ["déterminant"],
        ["adjectif"],
        ["nom"],
        ["genre"],
        ["nombre"]
      ]
    },
    {
      "id": "adjectif",
      "type": "definition",
      "titre": "L'adjectif qualificatif",
      "texte": "L'adjectif donne une précision sur le nom.",
      "exemple": "Un chat noir.",
      "mots_cles": [
        ["adjectif qualificatif"],
        ["précision"],
        ["nom"]
      ]
    },
    {
      "id": "adjectif-noms-coordonnes",
      "type": "regle",
      "titre": "Un adjectif pour plusieurs noms",
      "texte": "Avec des noms de genres différents, l'adjectif se met au masculin pluriel.",
      "exemple": "Un garçon et une fille contents.",
      "mots_cles": [
        ["plusieurs noms"],
        ["genres différents"],
        ["masculin pluriel"]
      ]
    },
    {
      "id": "degre-adjectif",
      "type": "definition",
      "titre": "L'intensité de l'adjectif",
      "texte": "Un adverbe peut rendre l'adjectif plus ou moins fort.",
      "exemple": "Un peu grand. Très grand.",
      "mots_cles": [
        ["intensité"],
        ["adverbe"],
        ["plus ou moins fort"]
      ]
    },
    {
      "id": "comparatif",
      "type": "definition",
      "titre": "Le comparatif",
      "texte": "Le comparatif sert à comparer deux éléments.",
      "exemple": "Lina est plus grande que Léa.",
      "mots_cles": [
        ["comparatif"],
        ["comparer deux éléments"]
      ]
    },
    {
      "id": "comparatifs-formes",
      "type": "formule",
      "titre": "Les 3 comparatifs",
      "texte": "Infériorité : moins... que. Égalité : aussi... que. Supériorité : plus... que.",
      "exemple": "Moins grand que ; aussi grand que ; plus grand que.",
      "mots_cles": [
        ["moins... que", "infériorité"],
        ["aussi... que", "égalité"],
        ["plus... que", "supériorité"]
      ]
    },
    {
      "id": "superlatif",
      "type": "definition",
      "titre": "Le superlatif",
      "texte": "Le superlatif indique le plus haut ou le plus bas degré.",
      "exemple": "Lina est la plus grande de la classe.",
      "mots_cles": [
        ["superlatif"],
        ["degré maximal"]
      ]
    },
    {
      "id": "superlatifs-formes",
      "type": "formule",
      "titre": "Les formes du superlatif",
      "texte": "Infériorité : le moins. Supériorité : le plus.",
      "exemple": "La moins grande ; la plus grande.",
      "mots_cles": [
        ["le moins", "infériorité"],
        ["le plus", "supériorité"]
      ]
    },
    {
      "id": "determinant",
      "type": "definition",
      "titre": "Le déterminant",
      "texte": "Le déterminant se place devant le nom et s'accorde avec lui.",
      "exemple": "Le chat ; les chats.",
      "mots_cles": [
        ["déterminant"],
        ["devant le nom"],
        ["accord"]
      ]
    },
    {
      "id": "articles",
      "type": "definition",
      "titre": "Les articles",
      "texte": "Les articles peuvent être définis, indéfinis ou partitifs.",
      "exemple": "Le chat ; un chat ; du pain.",
      "mots_cles": [
        ["articles"],
        ["définis"],
        ["indéfinis"],
        ["partitifs"]
      ]
    },
    {
      "id": "articles-definis",
      "type": "definition",
      "titre": "Les articles définis",
      "texte": "Les articles définis sont le, la, l' et les.",
      "exemple": "Le chien ; l'école ; les chiens.",
      "mots_cles": [
        ["le"],
        ["la"],
        ["l'"],
        ["les"]
      ]
    },
    {
      "id": "articles-contractes",
      "type": "definition",
      "titre": "Les articles définis contractés",
      "texte": "Au = à + le ; aux = à + les ; du = de + le ; des = de + les.",
      "mots_cles": [
        ["au"],
        ["aux"],
        ["du"],
        ["des"]
      ]
    },
    {
      "id": "articles-indefinis-partitifs",
      "type": "definition",
      "titre": "Les articles indéfinis et partitifs",
      "texte": "Indéfinis : un, une, des. Partitifs : du, de la, de l'.",
      "exemple": "Un gâteau ; du lait.",
      "mots_cles": [
        ["un", "une", "des"],
        ["du", "de la", "de l'"],
        ["indéfinis"],
        ["partitifs"]
      ]
    },
    {
      "id": "determinants-demonstratifs",
      "type": "definition",
      "titre": "Les déterminants démonstratifs",
      "texte": "Ils servent à montrer : ce, cet, cette, ces.",
      "exemple": "Cette maison ; ces livres.",
      "mots_cles": [
        ["démonstratifs"],
        ["ce"],
        ["cet"],
        ["cette"],
        ["ces"]
      ]
    },
    {
      "id": "determinants-possessifs",
      "type": "definition",
      "titre": "Les déterminants possessifs",
      "texte": "Ils indiquent à qui appartient quelque chose.",
      "exemple": "Mon sac ; ta trousse ; leurs livres.",
      "mots_cles": [
        ["possessifs"],
        ["mon"],
        ["ta"],
        ["leurs"],
        ["appartenance"]
      ]
    },
    {
      "id": "determinants-numeraux",
      "type": "definition",
      "titre": "Les déterminants numéraux",
      "texte": "Les cardinaux donnent un nombre. Les ordinaux donnent un rang.",
      "exemple": "Deux livres ; le premier livre.",
      "mots_cles": [
        ["cardinaux"],
        ["nombre"],
        ["ordinaux"],
        ["rang"]
      ]
    },
    {
      "id": "determinants-interrogatifs-exclamatifs",
      "type": "definition",
      "titre": "Les déterminants interrogatifs et exclamatifs",
      "texte": "Quel, quelle, quels et quelles accompagnent un nom.",
      "exemple": "Quelle heure est-il ? Quelle belle journée !",
      "mots_cles": [
        ["interrogatifs"],
        ["exclamatifs"],
        ["quel"],
        ["quelle"],
        ["quels"],
        ["quelles"]
      ]
    },
    {
      "id": "determinants-indefinis",
      "type": "definition",
      "titre": "Les déterminants indéfinis",
      "texte": "Ils indiquent une quantité ou une désignation imprécise.",
      "exemple": "Chaque élève ; plusieurs livres ; aucun bruit.",
      "mots_cles": [
        ["indéfinis"],
        ["quantité"],
        ["imprécise"],
        ["chaque"],
        ["plusieurs"],
        ["aucun"]
      ]
    },
    {
      "id": "pronom",
      "type": "definition",
      "titre": "Le pronom",
      "texte": "Le pronom remplace un nom ou un groupe nominal.",
      "exemple": "Lina arrive. Elle arrive.",
      "mots_cles": [
        ["pronom"],
        ["remplace"],
        ["nom"],
        ["groupe nominal"]
      ]
    },
    {
      "id": "accord-pronom",
      "type": "regle",
      "titre": "L'accord du pronom",
      "texte": "Le pronom s'accorde généralement en genre et en nombre avec ce qu'il remplace.",
      "exemple": "Le garçon arrive : il arrive.",
      "mots_cles": [
        ["pronom"],
        ["genre"],
        ["nombre"],
        ["mot remplacé"]
      ]
    },
    {
      "id": "pronoms-personnels",
      "type": "definition",
      "titre": "Les pronoms personnels",
      "texte": "Ils désignent les personnes qui parlent, à qui l'on parle ou dont on parle.",
      "exemple": "Je, tu, il, elle, nous, vous, ils, elles.",
      "mots_cles": [
        ["personnels"],
        ["je"],
        ["tu"],
        ["il"],
        ["elle"],
        ["nous"],
        ["vous"]
      ]
    },
    {
      "id": "pronoms-adverbiaux",
      "type": "definition",
      "titre": "Les pronoms adverbiaux",
      "texte": "Les deux pronoms adverbiaux sont y et en.",
      "exemple": "J'y vais. J'en veux.",
      "mots_cles": [
        ["adverbiaux"],
        ["y"],
        ["en"]
      ]
    },
    {
      "id": "pronoms-possessifs",
      "type": "definition",
      "titre": "Les pronoms possessifs",
      "texte": "Ils remplacent un nom en indiquant à qui il appartient.",
      "exemple": "Mon livre est ici ; le tien est là.",
      "mots_cles": [
        ["possessifs"],
        ["le mien"],
        ["la mienne"],
        ["le tien"],
        ["le sien"]
      ]
    },
    {
      "id": "pronoms-demonstratifs",
      "type": "definition",
      "titre": "Les pronoms démonstratifs",
      "texte": "Ils montrent ou désignent une personne ou une chose.",
      "exemple": "Celui-ci ; celle-là ; ceci ; cela.",
      "mots_cles": [
        ["démonstratifs"],
        ["celui"],
        ["celle"],
        ["ceci"],
        ["cela"]
      ]
    },
    {
      "id": "pronoms-relatifs",
      "type": "definition",
      "titre": "Les pronoms relatifs",
      "texte": "Ils relient deux parties d'une phrase.",
      "exemple": "Qui, que, quoi, dont, où.",
      "mots_cles": [
        ["relatifs"],
        ["qui"],
        ["que"],
        ["dont"],
        ["où"]
      ]
    },
    {
      "id": "pronoms-relatifs-composes",
      "type": "definition",
      "titre": "Les pronoms relatifs composés",
      "texte": "Ils sont formés de plusieurs éléments.",
      "exemple": "Lequel ; laquelle ; auxquels.",
      "mots_cles": [
        ["relatifs composés"],
        ["lequel"],
        ["laquelle"],
        ["auxquels"]
      ]
    },
    {
      "id": "pronoms-interrogatifs",
      "type": "definition",
      "titre": "Les pronoms interrogatifs",
      "texte": "Ils servent à poser une question.",
      "exemple": "Qui vient ? Lequel choisis-tu ?",
      "mots_cles": [
        ["interrogatifs"],
        ["question"],
        ["qui"],
        ["lequel"]
      ]
    },
    {
      "id": "pronoms-indefinis",
      "type": "definition",
      "titre": "Les pronoms indéfinis",
      "texte": "Ils désignent une personne ou une chose sans précision.",
      "exemple": "Quelqu'un arrive. Personne ne répond.",
      "mots_cles": [
        ["indéfinis"],
        ["sans précision"],
        ["quelqu'un"],
        ["personne"]
      ]
    },
    {
      "id": "pronoms-numeraux",
      "type": "definition",
      "titre": "Les pronoms numéraux",
      "texte": "Ils indiquent un nombre ou un rang en remplaçant un nom.",
      "exemple": "Trois sont arrivés. Le premier a gagné.",
      "mots_cles": [
        ["numéraux"],
        ["nombre"],
        ["rang"]
      ]
    }
  ],
  "alertes": [